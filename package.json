{
  "name": "kakko",
  "version": "0.1.0",
  "private": true,
  "description": "本人確認書類の不要な情報をブラウザ内だけでマスクし、提出先・用途を限定した安全なコピーを作るWebアプリ",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
